<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: do not back up the saved login. Its decryption key stays
     in the phone's keystore, so a restored copy cannot be read (BAD_DECRYPT). -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
</full-backup-content>
