<?xml version="1.0" encoding="utf-8"?>
<!-- The phone's own launch screen: the night colour with the CQ tile in the middle,
     where the game's splash draws it too. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_night" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_tile" />
    </item>
</layer-list>
